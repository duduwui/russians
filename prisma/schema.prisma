datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD
  SPLIT
}

enum SaleStatus {
  COMPLETED
  HELD
  REFUNDED
}

enum PrinterType {
  MOCK
  QZ_TRAY
  WEB_SERIAL
}

enum QuotationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CONVERTED
}

enum PurchaseStatus {
  ORDERED
  RECEIVED
  PARTIAL
}

enum TransferStatus {
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  name      String
  password  String   // Hashed password
  role      Role     @default(CASHIER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@map("users")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  nameKu    String?
  slug      String    @unique
  icon      String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id            String         @id @default(cuid())
  name          String
  nameKu        String?
  barcode       String         @unique
  price         Decimal        @db.Decimal(10, 2)
  cost          Decimal        @default(0.00) @db.Decimal(10, 2)
  stock         Int            @default(0)
  minStockAlert Int            @default(5)
  image         String?
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  transferItems TransferItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([barcode])
  @@index([name])
  @@index([categoryId])
  @@map("products")
}

model Sale {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  cashierId       String
  cashier         User          @relation(fields: [cashierId], references: [id])
  customerName    String        @default("Walk-in Customer")
  customerPhone   String?
  subtotal        Decimal       @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0.00) @db.Decimal(10, 2)
  discountPercent Decimal       @default(0.00) @db.Decimal(5, 2)
  taxAmount       Decimal       @default(0.00) @db.Decimal(10, 2)
  taxRate         Decimal       @default(0.00) @db.Decimal(5, 2)
  total           Decimal       @db.Decimal(10, 2)
  amountReceived  Decimal       @default(0.00) @db.Decimal(10, 2)
  changeDue       Decimal       @default(0.00) @db.Decimal(10, 2)
  paymentMethod   PaymentMethod @default(CASH)
  cashAmount      Decimal?      @db.Decimal(10, 2)
  cardAmount      Decimal?      @db.Decimal(10, 2)
  status          SaleStatus    @default(COMPLETED)
  notes           String?
  items           SaleItem[]
  refund          Refund?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([invoiceNumber])
  @@index([createdAt])
  @@index([status])
  @@index([cashierId])
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  price       Decimal  @db.Decimal(10, 2)
  cost        Decimal  @default(0.00) @db.Decimal(10, 2)
  quantity    Int
  discount    Decimal  @default(0.00) @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Refund {
  id           String   @id @default(cuid())
  saleId       String   @unique
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  reason       String
  refundAmount Decimal  @db.Decimal(10, 2)
  refundedBy   String
  createdAt    DateTime @default(now())

  @@map("refunds")
}

model Customer {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  nameKu     String?
  phone      String?
  email      String?
  address    String?
  totalSpent Decimal  @default(0.00) @db.Decimal(10, 2)
  dueBalance Decimal  @default(0.00) @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([code])
  @@index([name])
  @@map("customers")
}

model Supplier {
  id         String     @id @default(cuid())
  code       String     @unique
  name       String
  company    String?
  phone      String?
  email      String?
  address    String?
  balanceDue Decimal    @default(0.00) @db.Decimal(10, 2)
  purchases  Purchase[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([code])
  @@index([name])
  @@map("suppliers")
}

model Quotation {
  id             String          @id @default(cuid())
  quoteNumber    String          @unique
  customerName   String
  customerPhone  String?
  subtotal       Decimal         @db.Decimal(10, 2)
  discountAmount Decimal         @default(0.00) @db.Decimal(10, 2)
  taxAmount      Decimal         @default(0.00) @db.Decimal(10, 2)
  total          Decimal         @db.Decimal(10, 2)
  status         QuotationStatus @default(PENDING)
  validUntil     DateTime?
  notes          String?
  items          QuotationItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([quoteNumber])
  @@index([customerName])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  price       Decimal   @db.Decimal(10, 2)
  quantity    Int
  subtotal    Decimal   @db.Decimal(10, 2)

  @@map("quotation_items")
}

model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique
  supplierId     String?
  supplier       Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName   String
  totalAmount    Decimal        @db.Decimal(10, 2)
  paidAmount     Decimal        @default(0.00) @db.Decimal(10, 2)
  dueAmount      Decimal        @default(0.00) @db.Decimal(10, 2)
  status         PurchaseStatus @default(RECEIVED)
  notes          String?
  items          PurchaseItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([purchaseNumber])
  @@map("purchases")
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  costPrice   Decimal  @db.Decimal(10, 2)
  quantity    Int
  subtotal    Decimal  @db.Decimal(10, 2)

  @@map("purchase_items")
}

model StockTransfer {
  id             String         @id @default(cuid())
  transferNumber String         @unique
  sourceLocation String         @default("Store 01")
  destLocation   String
  status         TransferStatus @default(COMPLETED)
  totalItems     Int            @default(0)
  notes          String?
  items          TransferItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([transferNumber])
  @@map("stock_transfers")
}

model TransferItem {
  id          String        @id @default(cuid())
  transferId  String
  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  productName String
  quantity    Int

  @@map("transfer_items")
}

model Expense {
  id            String   @id @default(cuid())
  expenseNumber String   @unique
  title         String
  category      String   // Rent, Electricity, Salaries, Supplies, Maintenance, Other
  amount        Decimal  @db.Decimal(10, 2)
  paymentMethod String   @default("CASH")
  notes         String?
  expenseDate   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([category])
  @@index([expenseDate])
  @@map("expenses")
}

model CashRegisterSession {
  id            String    @id @default(cuid())
  sessionNumber String    @unique
  cashierName   String    @default("Admin")
  openingCash   Decimal   @db.Decimal(10, 2)
  closingCash   Decimal?  @db.Decimal(10, 2)
  expectedCash  Decimal?  @db.Decimal(10, 2)
  difference    Decimal?  @db.Decimal(10, 2)
  cashSales     Decimal   @default(0.00) @db.Decimal(10, 2)
  cashExpenses  Decimal   @default(0.00) @db.Decimal(10, 2)
  status        String    @default("OPEN") // OPEN, CLOSED
  openedAt      DateTime  @default(now())
  closedAt      DateTime?

  @@map("cash_register_sessions")
}

model Settings {
  id             String      @id @default("default")
  storeName      String      @default("FreshCart Store 01")
  storeNameKu    String?     @default("فرێش کارت فرۆشگای ٠١")
  storeAddress   String?     @default("100m Street, Erbil, Kurdistan")
  storePhone     String?     @default("+964 750 000 0000")
  receiptFooter  String?     @default("Thank you for shopping with us! / سوپاس بۆ سەردانەکەتان!")
  printerAdapter PrinterType @default(MOCK)
  taxRate        Decimal     @default(0.00) @db.Decimal(5, 2)
  currency       String      @default("USD")
  updatedAt      DateTime    @updatedAt

  @@map("settings")
}
